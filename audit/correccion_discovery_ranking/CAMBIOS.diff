+    "BWIN_VERIFIED",
+    "BWIN_NOT_SCANNED_BUDGET",
+    "BWIN_SEARCH_INCOMPLETE",
+    "BWIN_NOT_FOUND_IN_SCANNED_PAGES",
+    "BWIN_IDENTITY_CONFLICT",
+    "BWIN_MANUAL_LINK_PENDING_VALIDATION",
+    "BWIN_MANUAL_LINK_VERIFIED",
+})
